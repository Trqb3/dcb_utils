{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": false,
    "declarationDir": "typings",
    "emitDeclarationOnly": false,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "src",
    "allowJs": true
  },
  "include": ["src-ts/**/*.ts"],
  "exclude": ["node_modules", "typings", "src"]
}
